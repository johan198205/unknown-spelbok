{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spelbok-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--webpack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "spelbok-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
